first()
# Grafico base
p <- ggplot(dati_plot, aes(x = tempo, y = attivazioni_orarie, group = 1)) +
facet_grid(sensor_name ~ ., scales = "free_y") +
scale_y_continuous(
breaks = function(x) pretty(x, n = 3),
minor_breaks = NULL
) +
labs(
